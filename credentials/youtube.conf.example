# YouTube Data API v3 — OAuth de escritorio con refresh token.
# Renombrá este archivo a youtube.conf y completá los valores reales.
# Guía completa: docs/guia-youtube.md (§4 genera el refresh_token).
#
# IMPORTANTE: el refresh_token es un secreto de larga vida; si se filtra,
# revocalo en https://myaccount.google.com/permissions

CLIENT_ID=tu_client_id.apps.googleusercontent.com
CLIENT_SECRET=tu_client_secret_aqui
REFRESH_TOKEN=tu_refresh_token_aqui
PRIVACY_STATUS=public
CATEGORY_ID=20
