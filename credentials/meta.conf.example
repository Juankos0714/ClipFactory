# Meta / Facebook — publicación de Reels en una página.
# Renombrá este archivo a meta.conf y completá los valores reales.
#
# PAGE_ID: ID numérico de la página (Settings > Page info)
# ACCESS_TOKEN: Page Access Token (NO el token de usuario). Generá uno de
#   larga vida con la Graph API Explorer + Page selector.
# GRAPH_API_VERSION: versión de la Graph API (default v21.0)

PAGE_ID=tu_page_id_aqui
ACCESS_TOKEN=tu_page_access_token_aqui
GRAPH_API_VERSION=v21.0
