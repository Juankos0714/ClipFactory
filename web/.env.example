# Variables del frontend (web/). Sin secretos (AGENTS.md §5).
# Copiar a .env.local según necesidad:

# URL pública de la API sin el prefijo /api.
# Dev: vacío (usar proxy de Vite o el mock middleware con VITE_MOCK=true).
VITE_API_URL=

# Dev: TRUE activa el mock 12v. en Vite (headless sin backend).
VITE_MOCK=